# --- Privacy: never commit study content, media, or secrets ---

# Obsidian config - contains plugin settings INCLUDING your OpenAI API key
.obsidian/

# Your captured study content - keep local only
Sessions/
Flashcards/
Coaching/

# Media of any kind, anywhere
*.mp3
*.wav
*.webm
*.m4a
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mov

# Secrets
.env
*.env
*.key
secrets*

# Per-user runtime state (deck.json and scope.json ARE tracked as shipped defaults)
data/perf.json
data/review-state.json
data/runthrough-state.json

# Build output + downloaded prerequisites
dist/
bin/

# OS cruft
Thumbs.db
.DS_Store
desktop.ini
