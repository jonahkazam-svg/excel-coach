# Excel Coach configuration.
# Easiest setup: just run "Start Coach.bat" (or "tools\Set OpenAI key.bat") and paste your key when asked.
# Manual setup: copy this file to ".env" (same folder) and put your real key below.
#
# Get an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# ---- Optional overrides (defaults shown; uncomment to change) ----
# WATCH_MODEL=gpt-5.5       # "deep" model: Check-my-sheet audit, Explain-in-detail, Why-this-cell
# FAST_MODEL=gpt-5-mini     # "fast" model: Assist, Kick-start, quick answers (cheap + streams instantly)
# TTS=openai                # spoken-voice engine (set to "off" to mute the voice entirely)
# TTS_VOICE=onyx            # onyx / alloy / echo / fable / nova / shimmer
# MIC_DEVICE=               # exact mic device name, only if auto-detect picks the wrong input
